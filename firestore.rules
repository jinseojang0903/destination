rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
//
// Note: edits made through the Firebase Console's Firestore data viewer run
// with project-owner privileges and are NOT subject to these rules.
//
// The user's document is keyed by their verified phone number (not the
// Firebase Auth uid), so ownership is checked against the `phone_number`
// claim Firebase Auth puts on the ID token for phone-authenticated users.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.phone_number));
    }

    function isSelf(phoneNumber) {
      return request.auth != null && request.auth.token.phone_number == phoneNumber;
    }

    // Spending an official throw: attemptsRemaining may only go down,
    // attemptsGrantedTotal never touched by the client this way.
    function isSpendingAttempt() {
      return request.resource.data.attemptsRemaining <= resource.data.attemptsRemaining
        && request.resource.data.attemptsGrantedTotal == resource.data.attemptsGrantedTotal;
    }

    // Daily check-in: today's date must actually be new, exactly one date
    // added to the log, and the attempts bump bounded to at most +2 (daily
    // base + 7-day streak bonus) with attemptsGrantedTotal moving in
    // lockstep. Uses get(field, default) so accounts created before this
    // feature (missing checkIns/checkInStreak/lastCheckInDate) don't error
    // out on their first check-in. This can't verify the date is truly
    // "today" or the streak math from inside rules (no date functions in
    // this language), so it's resistant to casual abuse but not to someone
    // deliberately crafting raw API calls — acceptable for a small app
    // among friends.
    function isValidCheckIn() {
      let delta = request.resource.data.attemptsRemaining - resource.data.get('attemptsRemaining', 0);
      return request.resource.data.lastCheckInDate != resource.data.get('lastCheckInDate', null)
        && request.resource.data.checkIns.size() == resource.data.get('checkIns', []).size() + 1
        && request.resource.data.checkInStreak is int
        && request.resource.data.checkInStreak > 0
        && delta >= 0 && delta <= 2
        && request.resource.data.attemptsGrantedTotal == resource.data.get('attemptsGrantedTotal', 0) + delta;
    }

    // Admin markers — added manually via the Firebase console only
    // (README.md "관리자 지정하기"). Each user may only check their own.
    match /admins/{phoneNumber} {
      allow get: if request.auth != null && request.auth.token.phone_number == phoneNumber;
      allow list, write: if false;
    }

    match /users/{phoneNumber} {
      // Admins can also read other users' docs — needed because approving a
      // request reads the target account's current attemptsRemaining first.
      allow read: if request.auth != null && (request.auth.token.phone_number == phoneNumber || isAdmin());

      // Only the sign-in flow creates this doc, once, for the caller's own phone number.
      allow create: if request.auth != null && request.auth.token.phone_number == phoneNumber;

      // The account owner may spend an attempt (decrease only) or check in
      // (bounded increase, see isValidCheckIn). Anything else that
      // increases attempts — like approving a request — requires isAdmin().
      allow update: if isAdmin()
        || (isSelf(phoneNumber) && (isSpendingAttempt() || isValidCheckIn()));

      allow delete: if false;

      match /history/{historyId} {
        allow read: if request.auth != null && request.auth.token.phone_number == phoneNumber;
        allow create: if request.auth != null && request.auth.token.phone_number == phoneNumber;
        // History is an immutable log: no edits or deletes from the client.
        allow update, delete: if false;
      }
    }

    // "관리자에게 기회 달라고 조르기" requests. Anyone can file one for
    // themselves; only an admin can approve/reject (which is what's allowed
    // to grant more attempts on the matching users/{phoneNumber} doc above).
    match /attemptRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && request.resource.data.status == "pending"
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000;

      allow read: if request.auth != null
        && (resource.data.phoneNumber == request.auth.token.phone_number || isAdmin());

      allow update: if isAdmin();
      allow delete: if false;
    }

    // Manual kill switch for phone-auth sign-in (systemStatus/config,
    // field phoneAuthEnabled). Must be publicly readable since it's checked
    // on the login page before anyone is signed in; only ever writable by
    // the developer directly in the console.
    match /systemStatus/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
