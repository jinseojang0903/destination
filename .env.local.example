# Mapbox (https://account.mapbox.com/access-tokens/) - public token, safe to expose client-side
NEXT_PUBLIC_MAPBOX_TOKEN=

# Firebase project config (Firebase Console > Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Unsplash (https://unsplash.com/oauth/applications) - kept server-side only, used by /api/photo
UNSPLASH_ACCESS_KEY=

# Sentry (https://sentry.io) - optional, error monitoring. Public DSN, safe to expose client-side.
# Leave blank and error reporting just no-ops.
NEXT_PUBLIC_SENTRY_DSN=
